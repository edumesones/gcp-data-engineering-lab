# Paso 4 · Variables del compose. No contiene secretos: solo rutas e identificadores.
# Copia este fichero a `.env` y ajusta ADC_PATH. El .gitignore excluye los `.env`.

# En Linux, Airflow pide el UID del usuario del host. En Windows y macOS avisa de que no está puesto y se puede
# ignorar; el propio compose usa 50000 por defecto, así que se fija explícitamente.
AIRFLOW_UID=50000

# Imagen oficial de la versión que usa por defecto el Airflow gestionado de Google.
AIRFLOW_IMAGE_NAME=apache/airflow:2.11.1

# Credenciales por defecto de la aplicación (ADC), creadas con impersonación de la cuenta del pipeline.
# NUNCA una clave de cuenta de servicio. En Windows, gcloud las escribe en
# %APPDATA%\gcloud\application_default_credentials.json
ADC_PATH=C:/Users/<usuario>/AppData/Roaming/gcloud/application_default_credentials.json
